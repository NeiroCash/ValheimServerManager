<Window x:Class="ValheimServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ValheimServerManager.Views"
        xmlns:vm="clr-namespace:ValheimServerManager.ViewModels"
        Title="Valheim Server Manager"
        Width="1500"
        Height="920"
        MinWidth="1200"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="108" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F1D29">
            <Grid Margin="24,18,22,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VALHEIM" FontSize="34" FontWeight="Bold" Foreground="#E9F4FF" />
                    <TextBlock Text="Server Manager" FontSize="30" FontWeight="SemiBold" Margin="12,0,0,0" Foreground="#E6EEF6" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="v0.1.0" Margin="10,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />

                <TextBlock Grid.Column="2" Text="A home in the tenth world" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:NavigationSidebar Grid.Column="0" />
            <views:DashboardView Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
