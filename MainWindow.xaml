<Window x:Class="ValheimServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ValheimServerManager.Views"
        xmlns:vm="clr-namespace:ValheimServerManager.ViewModels"
        Title="Valheim Server Manager"
        Width="1500" Height="920" MinWidth="1200" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigurationViewModel}"><views:ConfigurationView /></DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="108" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid Margin="24,18,22,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VALHEIM" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Server Manager" FontSize="30" FontWeight="SemiBold" Margin="12,0,0,0" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="v0.1.0" Margin="10,12,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                <TextBlock Grid.Column="2" Text="A home in the tenth world" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <views:NavigationSidebar Grid.Column="0" />
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
