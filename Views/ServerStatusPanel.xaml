<UserControl x:Class="ValheimServerManager.Views.ServerStatusPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ValheimServerManager.ViewModels">
    <UserControl.DataContext>
        <vm:DashboardViewModel />
    </UserControl.DataContext>

    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
        <StackPanel>
            <TextBlock Text="Server Status" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <Ellipse Width="90" Height="90" Stroke="{StaticResource AccentBrush}" StrokeThickness="8" Fill="Transparent" />
                    <TextBlock Text="12%" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-58,0,0" />
                    <TextBlock Text="CPU" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Ellipse Width="90" Height="90" Stroke="{StaticResource SuccessBrush}" StrokeThickness="8" Fill="Transparent" />
                    <TextBlock Text="28%" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-58,0,0" />
                    <TextBlock Text="RAM" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,22,0,0">
                <TextBlock Text="Players: 3 / 10" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,6" />
                <TextBlock Text="World: MyWorld" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,6" />
                <TextBlock Text="Game version: 1.0.14" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,6" />
                <TextBlock Text="Server version: 1.0.14" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,6" />
                <TextBlock Text="BepInEx: 5.4.23.2" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,6" />
                <TextBlock Text="Mods loaded: 6" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
