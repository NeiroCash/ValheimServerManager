<UserControl x:Class="ValheimServerManager.Views.ModsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ValheimServerManager.ViewModels">
    <UserControl.DataContext>
        <vm:DashboardViewModel />
    </UserControl.DataContext>

    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Mods (BepInEx)" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock Grid.Column="1" Text="BepInEx Enabled" Foreground="{StaticResource SuccessBrush}" FontSize="12" VerticalAlignment="Center" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Mods}" Margin="0,18,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" />
                                <TextBlock Text="{Binding Version}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Type}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
