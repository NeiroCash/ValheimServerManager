<UserControl x:Class="ValheimServerManager.Views.NavigationSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SidebarBackgroundBrush}">
    <Border Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="18,22,12,0">
                <Button Content="Dashboard" Style="{StaticResource SidebarNavButtonStyle}" IsEnabled="True" />
                <Button Content="World Settings" Style="{StaticResource SidebarNavButtonStyle}" />
                <Button Content="Mods" Style="{StaticResource SidebarNavButtonStyle}" />
                <Button Content="Console / Logs" Style="{StaticResource SidebarNavButtonStyle}" />
                <Button Content="Players" Style="{StaticResource SidebarNavButtonStyle}" />
                <Button Content="Backups" Style="{StaticResource SidebarNavButtonStyle}" />
                <Button Content="Schedules" Style="{StaticResource SidebarNavButtonStyle}" />
                <Button Content="Configuration" Style="{StaticResource SidebarNavButtonStyle}" />
            </StackPanel>

            <Border Grid.Row="1" Padding="12,12,12,16" Margin="12,0,12,16" Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Server connected" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="D:/Games/ValheimServer/" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
