<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0D1820" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0B1320" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#162B3B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#25415A" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#EFF7FF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B7C9D7" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#7C8FA1" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4AA3FF" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#2E7ACB" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#50D67A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E07676" />
    <SolidColorBrush x:Key="ConfigInputBackgroundBrush" Color="#122331" />

    <Style x:Key="SidebarNavButtonStyle" TargetType="Button"><Setter Property="Height" Value="42" /><Setter Property="Margin" Value="0,0,0,6" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="14,0,14,0" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="Transparent" CornerRadius="8"><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#102534" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button"><Setter Property="Height" Value="34" /><Setter Property="MinWidth" Value="90" /><Setter Property="Margin" Value="0,0,10,0" /><Setter Property="Padding" Value="16,0,16,0" /><Setter Property="Background" Value="{StaticResource AccentBrush}" /><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}"><Setter Property="Background" Value="#1A2E3F" /><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style x:Key="AccentActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}"><Setter Property="Background" Value="#1F73B9" /></Style>
</ResourceDictionary>
