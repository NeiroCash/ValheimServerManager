<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ConfigCardStyle" TargetType="Border"><Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="16" /></Style>
    <Style x:Key="ConfigCardTitleStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="Margin" Value="0,0,0,14" /></Style>
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /><Setter Property="FontSize" Value="13" /><Setter Property="Margin" Value="0,8,0,5" /></Style>
    <Style x:Key="ConfigTextBoxStyle" TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource ConfigInputBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="9,7" /><Setter Property="FontSize" Value="13" /><Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" /></Style>
    <Style x:Key="ConfigComboBoxItemStyle" TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" /><Setter Property="Padding" Value="10,7" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Trigger></Style.Triggers></Style>
    <Style x:Key="ConfigComboBoxStyle" TargetType="ComboBox"><Setter Property="Background" Value="{DynamicResource ConfigInputBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="7" /><Setter Property="Margin" Value="0,0,0,4" /><Setter Property="FontSize" Value="13" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="ItemContainerStyle" Value="{StaticResource ConfigComboBoxItemStyle}" /></Style>
    <Style x:Key="ConfigCheckBoxStyle" TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /><Setter Property="FontSize" Value="13" /><Setter Property="Margin" Value="0,10,0,0" /></Style>
</ResourceDictionary>
